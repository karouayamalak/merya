# MERYA DZ Backend — Environment Variables Template
# Copy this file to .env and fill in your production values

PORT=5000
NODE_ENV=production

# MongoDB Connection String (MUST support transactions in production — e.g. MongoDB Atlas or a local replica set)
# Production (MongoDB Atlas Replica Set):
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/merya_dz?retryWrites=true&w=majority
# Development replica set example:
# MONGODB_URI=mongodb://127.0.0.1:27018/merya_dz?replicaSet=rs0

# JWT Signing Secret (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_strong_random_jwt_secret_here
JWT_EXPIRES_IN=7d

# Cookie Signing Secret
COOKIE_SECRET=your_strong_random_cookie_secret_here

# CSRF Protection Secret (Defaults to COOKIE_SECRET if omitted, but recommended to set independently)
CSRF_SECRET=your_strong_random_csrf_secret_here

# Cookie SameSite Setting (Use 'none' if frontend and backend are hosted on different domains e.g. vercel.app + render.com)
# Values: none | lax | strict
COOKIE_SAME_SITE=none

# Production Frontend Origin (Strict CORS & WebSocket Origin check; no trailing slash)
CLIENT_ORIGIN=https://your-merya-frontend.vercel.app

# Admin Bootstrap Credentials (Used during initial setup/seeding)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@merya.dz
ADMIN_PASSWORD=change_this_strong_password_in_production

# Cloudinary Cloud Storage (REQUIRED in production on ephemeral hosts like Render / Fly.io for image persistence)
# In production, image uploads are strictly rejected if Cloudinary credentials are missing.
# Free accounts available at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
