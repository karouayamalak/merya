# MERYA DZ Backend — Environment Variables Template
# Copy this file to .env and fill in your production values

PORT=5000
NODE_ENV=production

# MongoDB Database Connection String
# For local development: mongodb://127.0.0.1:27017/merya_dz
# For production (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/merya_dz?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/merya_dz

# JWT Secret & Expiration (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_strong_random_jwt_secret_here
JWT_EXPIRES_IN=7d

# Cookie Secret
COOKIE_SECRET=your_strong_random_cookie_secret_here

# Frontend Origin URL (For CORS whitelist in production, e.g. https://merya-dz.vercel.app)
CLIENT_ORIGIN=http://localhost:5173

# Optional: Cloudinary Cloud Storage (Required for persistent images on serverless/ephemeral hosts like Vercel/Render)
# Get these free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
