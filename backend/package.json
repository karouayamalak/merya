{
  "name": "merya-dz-backend",
  "version": "1.0.0",
  "description": "Production Full-Stack Backend for MERYA DZ modest fashion brand",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed/seed.js",
    "test": "node --env-file=.env --test --test-concurrency=1 tests/**/*.test.js",
    "test:all": "node --env-file=.env scripts/runAllTests.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.35.4",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  }
}
