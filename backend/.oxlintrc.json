{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc"],
  "globals": {
    "console": "readonly",
    "process": "readonly",
    "fetch": "readonly",
    "URL": "readonly",
    "setTimeout": "readonly",
    "clearTimeout": "readonly",
    "setInterval": "readonly",
    "clearInterval": "readonly",
    "Date": "readonly",
    "Error": "readonly",
    "Promise": "readonly",
    "JSON": "readonly",
    "Map": "readonly",
    "Set": "readonly",
    "Object": "readonly",
    "Array": "readonly",
    "String": "readonly",
    "Number": "readonly",
    "Boolean": "readonly",
    "RegExp": "readonly",
    "Buffer": "readonly",
    "global": "readonly",
    "module": "readonly",
    "require": "readonly",
    "__dirname": "readonly",
    "__filename": "readonly",
    "exports": "readonly"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-undef": "error",
    "no-console": "warn",
    "prefer-const": "error",
    "no-var": "error"
  }
}