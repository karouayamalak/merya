# MERYA DZ Frontend — Environment Variables Template
# In local development, leave these blank to use the local Vite proxy.
# In production on Vercel/Netlify, set these to your backend server URL.

# Backend API URL (e.g. https://merya-api.onrender.com or https://merya-backend.up.railway.app)
VITE_API_URL=

# Backend Root URL for serving static uploads (e.g. https://merya-api.onrender.com)
VITE_BACKEND_URL=

# Backend WebSocket URL (e.g. wss://merya-api.onrender.com)
VITE_WS_URL=
